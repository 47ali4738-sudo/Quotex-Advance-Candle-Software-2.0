<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Advance Candle Prototype</title><style>
:root{color-scheme:dark;--bg:#0b1118;--panel:#121c27;--line:#263544;--text:#edf4fa;--muted:#8fa2b5;--green:#20d49a;--red:#ff6475;--blue:#58a6ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font:15px system-ui}header{padding:18px;background:#0e1721;border-bottom:1px solid var(--line)}.brand{font-weight:800;font-size:20px}.sub,.small{color:var(--muted);font-size:12px;margin-top:4px}main{max-width:850px;margin:auto;padding:14px;display:grid;gap:12px}.panel,.controls,.stats,.forecast article{background:var(--panel);border:1px solid var(--line);border-radius:13px;padding:13px}.controls{display:grid;grid-template-columns:1fr 1fr;gap:10px}label{display:block;color:var(--muted);font-size:12px;margin-bottom:6px}select,button{width:100%;padding:11px;border:1px solid #35495b;border-radius:9px;background:#0b141e;color:var(--text);font:inherit}button{background:#155f52;font-weight:700}.status{grid-column:1/-1;font-size:12px;color:var(--muted)}.charthead{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.pair{font-weight:750}.pill{font-size:11px;padding:5px 8px;background:#243442;border-radius:20px}.chartwrap{height:310px;background:#081018;border:1px solid #1e2c38;border-radius:10px;overflow:hidden}canvas{width:100%;height:100%;display:block}.legend{font-size:12px;color:var(--muted);margin-top:8px}.stats,.forecast{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.stat{padding:10px;background:#0c151e;border-radius:9px}.stat small{display:block;color:var(--muted);font-size:11px}.stat strong{display:block;margin-top:5px}.forecast{grid-template-columns:1fr 1fr}.forecast h3{font-size:12px;color:var(--muted);margin:0 0 8px}.direction{font-size:17px;font-weight:800}.note{background:#182532;border-left:3px solid #e7b65c;border-radius:7px;padding:12px;font-size:12px;line-height:1.5}@media(min-width:680px){main{grid-template-columns:1fr 1fr}.controls,.chartpanel,.note{grid-column:1/-1}.chartwrap{height:390px}}
</style></head><body><header><div class="brand">◈ ADVANCE CANDLE</div><div class="sub">Two-candle projection • Android web prototype</div></header><main>
<section class="controls"><div><label>MARKET PAIR</label><select id="pair"><option>EUR/USD</option><option>GBP/USD</option><option>USD/JPY</option><option>AUD/USD</option><option>EUR/USD OTC</option><option>GBP/USD OTC</option><option>USD/JPY OTC</option></select></div><div><label>CHART TIMEFRAME</label><select id="tf"><option value="60">1 minute</option><option value="120">2 minutes</option><option value="300">5 minutes</option></select></div><div><label>PROJECTION HORIZON</label><select><option>120 seconds</option></select></div><div><label>&nbsp;</label><button id="refresh">Refresh demo candles</button></div><div class="status" id="status">DEMO MODE • No broker feed connected</div></section>
<section class="panel chartpanel"><div class="charthead"><div><div class="pair" id="chartPair">EUR/USD</div><div class="sub">Simulated market + two projected candles</div></div><span class="pill">120s PROJECTED</span></div><div class="chartwrap"><canvas id="chart"></canvas></div><div class="legend">🟢 Bullish &nbsp; 🔴 Bearish &nbsp; 🔵 Projected candles</div></section>
<section class="stats"><div class="stat"><small>Projection horizon</small><strong>120 sec</strong></div><div class="stat"><small>Verified accuracy</small><strong>Not tested</strong></div><div class="stat"><small>Demo refreshes</small><strong id="count">0</strong></div></section>
<section class="forecast"><article><h3>PROJECTED CANDLE 1</h3><div class="direction" id="d1">—</div><div class="small">Illustrative body and wicks</div></article><article><h3>PROJECTED CANDLE 2</h3><div class="direction" id="d2">—</div><div class="small">Illustrative body and wicks</div></article></section>
<section class="note"><b>Important:</b> This is a visual prototype with simulated candles, not a live Quotex connection. The extra candles are illustrative estimates, not actual future prices. Live and OTC synchronization requires a compatible data source; 90–95% accuracy cannot be guaranteed and must be independently tested.</section></main>
<script>
const cv=document.getElementById('chart'),ctx=cv.getContext('2d');let seed=41,n=0,data=[];
function rand(){seed=(seed*9301+49297)%233280;return seed/233280}
function make(){let a=[],p=100;for(let i=0;i<24;i++){let o=p,c=o+(rand()-.49)*3;a.push({o,c,h:Math.max(o,c)+rand()*1.3,l:Math.min(o,c)-rand()*1.3,f:false});p=c}for(let i=0;i<2;i++){let o=p,c=o+(rand()-.47)*3;a.push({o,c,h:Math.max(o,c)+rand()*1.3,l:Math.min(o,c)-rand()*1.3,f:true});p=c}return a}
function draw(){let r=cv.getBoundingClientRect(),d=window.devicePixelRatio||1;cv.width=r.width*d;cv.height=r.height*d;ctx.setTransform(d,0,0,d,0,0);let w=r.width,h=r.height;ctx.fillStyle='#081018';ctx.fillRect(0,0,w,h);let lo=Math.min(...data.map(c=>c.l))-1,hi=Math.max(...data.map(c=>c.h))+1,slot=w/(data.length+1),bw=Math.max(4,Math.min(12,slot*.55)),Y=v=>h-14-(v-lo)/(hi-lo)*(h-28);for(let j=0;j<6;j++){ctx.strokeStyle='#1b2935';ctx.beginPath();ctx.moveTo(0,10+j*(h-20)/5);ctx.lineTo(w,10+j*(h-20)/5);ctx.stroke()}data.forEach((c,i)=>{let x=slot*(i+.8),col=c.c>=c.o?'#20d49a':'#ff6475';ctx.strokeStyle=c.f?'#58a6ff':col;ctx.lineWidth=1.5;ctx.setLineDash(c.f?[4,3]:[]);ctx.beginPath();ctx.moveTo(x,Y(c.h));ctx.lineTo(x,Y(c.l));ctx.stroke();ctx.setLineDash([]);let t=Y(Math.max(c.o,c.c)),b=Y(Math.min(c.o,c.c));ctx.fillStyle=c.f?'rgba(88,166,255,.35)':col;ctx.fillRect(x-bw/2,t,bw,Math.max(2,b-t));ctx.strokeStyle=c.f?'#58a6ff':col;ctx.strokeRect(x-bw/2,t,bw,Math.max(2,b-t))});ctx.fillStyle='#58a6ff';ctx.font='11px system-ui';ctx.fillText('TWO PROJECTED CANDLES →',Math.max(8,w-slot*6),16)}
function update(){seed+=29;data=make();document.getElementById('chartPair').textContent=document.getElementById('pair').value;[data[data.length-2],data[data.length-1]].forEach((c,i)=>{let e=document.getElementById('d'+(i+1));e.textContent=c.c>=c.o?'▲ GREEN / BULLISH':'▼ RED / BEARISH';e.style.color=c.c>=c.o?'#20d49a':'#ff6475'});document.getElementById('count').textContent=++n;draw()}
document.getElementById('refresh').onclick=update;document.getElementById('pair').onchange=update;document.getElementById('tf').onchange=update;window.onresize=draw;update();
</script></body></html>
